# 이 파일을 .env로 복사해 설정한다. 실제 키는 커밋하지 않는다.
PORT=8080
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# SOLAPI에 사전 등록한 발신번호. 숫자만 입력한다.
SOLAPI_SENDER_PHONE=
# 인증번호 HMAC 전용 비밀값. SOLAPI API Secret과 별도로 생성한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PHONE_VERIFICATION_SECRET=
# Postmark 서버 API 토큰과 인증된 발신 이메일·표시 이름. 실제 값은 전달받은 뒤 설정한다.
# POSTMARK_API_TEST 토큰은 런타임 성공을 만들지 않도록 거부한다. 모의 발송은 테스트에서만 한다.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=
# 앱의 재설정 화면을 여는 전체 URL. https: 또는 기존 hpluseco: 스킴을 허용한다.
# 실제 도메인/연결 방식은 미정이며 기본값이 없다. 쿼리·fragment 없이 설정하고 서버가 token 쿼리를 추가한다.
# HTTPS 링크의 앱 연결 설정은 별도 작업이다. URL을 넣는 것만으로 앱 연동이 완료되지 않는다.
PASSWORD_RESET_URL=
# 관리자 최대 세션 유지기간(초). 정책을 정한 후 입력하며 기본값은 없다.
# 초기 관리자 계정 생성은 아직 제공하지 않는다.
ADMIN_SESSION_TTL_SECONDS=
