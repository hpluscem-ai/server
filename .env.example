# 이 파일을 .env로 복사해 설정한다. 실제 키는 커밋하지 않는다.
PORT=8080
# 개발/로컬 및 Vercel Preview/Development용 설정.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# SOLAPI에 사전 등록한 발신번호. 숫자만 입력한다.
SOLAPI_SENDER_PHONE=
# Vercel은 VERCEL_ENV=production일 때 아래 라이브 설정만 사용한다.
# VERCEL_ENV가 없는 서버는 NODE_ENV=production일 때 라이브 설정을 사용한다.
# 선택한 환경의 설정이 비어 있으면 다른 환경의 값으로 대체하지 않는다.
SOLAPI_API_KEY_LIVE=
SOLAPI_API_SECRET_LIVE=
# 라이브 SOLAPI 계정에 사전 등록한 발신번호. 숫자만 입력한다.
SOLAPI_SENDER_PHONE_LIVE=
# 인증번호 HMAC 전용 비밀값. SOLAPI API Secret과 별도로 생성한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PHONE_VERIFICATION_SECRET=
# Resend API 키와 인증된 발신 이메일·표시 이름. 실제 키는 .env에만 설정한다.
# onboarding@resend.dev는 Resend 계정 소유자에게 보내는 테스트용 발신 주소다.
# 실제 사용자 발송에는 인증된 회사 도메인이 필요하며 도메인의 열람·클릭 추적은 끈다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# 앱의 재설정 화면을 여는 전체 URL. https: 또는 기존 hpluseco: 스킴을 허용한다.
# 로컬 HTTP는 비운영 환경의 localhost/127.0.0.1/[::1]만 허용한다.
# 로컬 예시: http://localhost:4000/reset-password
# 운영 도메인/연결 방식은 미정이며 기본값이 없다. 쿼리·fragment 없이 설정하고 서버가 token 쿼리를 추가한다.
# HTTPS 링크의 앱 연결 설정은 별도 작업이다. URL을 넣는 것만으로 앱 연동이 완료되지 않는다.
PASSWORD_RESET_URL=
# 관리자 최대 세션 유지기간(초), 8시간 이하. 자동 연장·기본값 없음.
# 초기 관리자 계정 생성은 아직 제공하지 않는다.
ADMIN_SESSION_TTL_SECONDS=28800

# 웹 로그인·CORS 허용 Origin. 로컬 예시: http://localhost:4000,http://localhost:5173
# 쉼표로 구분하며 와일드카드·URL 경로는 허용하지 않는다. 비어 있으면 웹 로그인을 허용하지 않는다.
WEB_ORIGINS=
# 로컬 HTTP 쿠키 테스트는 NODE_ENV=development, 운영 HTTPS에서는 production을 사용한다.

# 비공개 사진 저장소. 버킷은 자동 생성하지 않는다. 없으면 사진 요청은 503이다.
# 버킷의 공개 접근을 끄고 해당 버킷에만 권한이 있는 키를 설정한다.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# OCR 판독 설정과 별개다. 정책·실제 정답 평가·활성화 승인 이후에만 true로 설정한다.
# 누락 또는 true 외의 값은 자동 승인을 비활성화한다. 과거 작업을 소급 승인하지 않는다.
MILEAGE_OCR_AUTO_APPROVE_ENABLED=false

# GPT-6 Luna mileage OCR (choose an approved daily request budget before enabling)
OPENAI_API_KEY=
MILEAGE_OCR_ENABLED=false
MILEAGE_OCR_LUNA_DAILY_LIMIT=
